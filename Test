      if(h.address) html+=`<div class="item">📍 العنوان: ${h.address}</div>`;
      if(h.checkIn) html+=`<div class="item">📅 تسجيل الدخول: ${h.checkIn}</div>`;
      if(h.checkOut) html+=`<div class="item">📅 تسجيل الخروج: ${h.checkOut}</div>`;
      if(h.nightsText) html+=`<div class="item">🌙 ${h.nightsText}</div>`;
      h.rooms.forEach((r,ri)=>{
        html+=`<div class="item room-title" style="font-weight:800;color:#e2e8f0;">🛏 غرفة ${ri+1}: ${r.roomName}</div>`;
        let occ=`${r.adults} بالغ`;
        if(r.children) occ+=` - ${r.children}`;
        html+=`<div class="item">تتسع لـ: ${occ}</div><div class="item">الوجبات: ${r.meals}</div>`;
      });
    });
  }
  html+=`<div class="line"></div><div class="item price-line" style="font-weight:800;font-size:14.5px;color:#4ade80;">💰 ${priceText}</div>`;
  if(isOmra){
    html+=`<div class="small">⚠️ ملاحظة: السعر والإمكانية غير ثابتين لحين إتمام الحجز.</div>`;
  } else if(hasHotel){
    html+=`<div class="small">⚠️ ملاحظة: السعر والإمكانية غير ثابتين لحين إتمام الحجز.</div><div class="small">⚠️ ملاحظة: شامل السعر الأساسي والضرائب للفندق، وغير شامل ضريبة السياحة بالمدينة إن وُجدت.</div>`;
  } else {
    html+=`<div class="small">⚠️ ملاحظة: السعر والإمكانية غير ثابتين لحين إتمام الحجز.</div>`;
  }
  document.getElementById("out").innerHTML=html;
}

/* ============================================================
   COPY TEXT (with clipboard error handling)
============================================================ */
function copyText(){
  let out=document.getElementById("out");
  let outContent=out.innerHTML.trim();
  if(!outContent||outContent==="سيظهر العرض المنسق هنا جاهز للنسخ..."){
    showToast("⚠️ لا يوجد عرض لنسخه — أنشئ العرض أولاً");
    return;
  }
  let lines=[],B="\u2063",S="************************";
  let hasHotelInOutput=outContent.includes("تفاصيل الفنادق");
  out.querySelectorAll(".title,.date-range-line,.item,.layover,.line,.small").forEach(el=>{
    if(el.classList.contains("line")){lines.push("────────────────");lines.push(B);}
    else if(el.classList.contains("title")){lines.push(`*${el.innerText.trim()}*`);lines.push(B);}
    else if(el.classList.contains("date-range-line")){lines.push(`*${el.innerText.trim()}*`);lines.push(B);}
    else if(el.classList.contains("layover")){lines.push(B);lines.push(S);lines.push(`*${el.innerText.trim()}*`);lines.push(S);lines.push(B);}
    else if(el.classList.contains("leg-title")){lines.push(B);lines.push(`*${el.innerText.trim()}*`);}
    else if(el.classList.contains("hotels-header")){lines.push(`*${el.innerText.trim()}*`);}
    else if(el.classList.contains("hotel-name")){lines.push(B);lines.push(`*${el.innerText.trim()}*`);}
    else if(el.classList.contains("room-title")){lines.push(`*${el.innerText.trim()}*`);}
    else if(el.classList.contains("price-line")){lines.push(`*${el.innerText.trim()}*`);}
    else if(el.classList.contains("transit-header")){lines.push(`*${el.innerText.trim()}*`);}
    else if(el.classList.contains("date-item")&&hasHotelInOutput){lines.push(`*${el.innerText.trim()}*`);}
    else if(el.classList.contains("small")){lines.push(el.innerText.trim());}
    else{lines.push(el.innerText.trim());}
  });
  navigator.clipboard.writeText(lines.join("\n"))
    .then(()=>showToast("✅ تم نسخ العرض"))
    .catch(()=>{
      // Fallback for browsers that block clipboard
      let ta=document.createElement("textarea");
      ta.value=lines.join("\n");
      ta.style.position="fixed";ta.style.opacity="0";
      document.body.appendChild(ta);ta.select();
      try{document.execCommand("copy");showToast("✅ تم نسخ العرض");}
      catch{showToast("❌ تعذّر النسخ — انسخ يدوياً");}
      document.body.removeChild(ta);
    });
}

