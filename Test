/* ============================================================
   DATE / TIME HELPERS
============================================================ */
const monthsMap={"JAN":"يناير","FEB":"فبراير","MAR":"مارس","APR":"أبريل","MAY":"مايو","JUN":"يونيو","JUL":"يوليو","AUG":"أغسطس","SEP":"سبتمبر","OCT":"أكتوبر","NOV":"نوفمبر","DEC":"ديسمبر"};
const monthsPattern="JAN|FEB|MAR|APR|MAY|JUN|JUL|AUG|SEP|OCT|NOV|DEC";
const monthIndex={"JAN":0,"FEB":1,"MAR":2,"APR":3,"MAY":4,"JUN":5,"JUL":6,"AUG":7,"SEP":8,"OCT":9,"NOV":10,"DEC":11};

function periodLabel(h){
  // Arabic time-of-day labels per the agreed hour ranges
  if(h===0) return "بعد منتصف الليل";
  if(h>=1&&h<=4) return "فجراً";
  if(h>=5&&h<=10) return "صباحاً";
  if(h>=11&&h<=13) return "ظهراً";
  if(h>=14&&h<=15) return "عصراً";
  return "مساءً"; // 16–23
}

function to12(t){
  if(!t) return"";
  t=String(t).replace(/\+1$/,'').replace(/^#/,'').trim();
  if(t.length<4) return"";
  let h=parseInt(t.slice(0,2)),m=t.slice(2,4);
  if(isNaN(h)||h>23) return"";
  let p=periodLabel(h);
  let h12=h%12; if(h12===0) h12=12;
  return`${h12<10?"0"+h12:h12}:${m} ${p}`;
}

function calcLayover(a,d){
  if(!a||!d) return"";
  a=String(a).replace(/\+1$/,'').replace(/^#/,'');
  d=String(d).replace(/\+1$/,'').replace(/^#/,'');
  let aT=parseInt(a.slice(0,2))*60+parseInt(a.slice(2,4));
  let dT=parseInt(d.slice(0,2))*60+parseInt(d.slice(2,4));
  if(dT<aT) dT+=1440;
  let diff=dT-aT,h=Math.floor(diff/60),m=diff%60;
  let hT=h>0?(h===1?"ساعة":h===2?"ساعتان":h<=10?`${h} ساعات`:`${h} ساعة`):"";
  let mT=m>0?`${m} دقيقة`:"";
  return h>0&&m>0?`${hT} و ${mT}`:hT+mT;
}

function formatDate(r){
  if(!r) return"";
  let m=r.match(new RegExp(`(\\d{1,2})\\s*(${monthsPattern})`,'i'));
  return m?`${m[1]} ${monthsMap[m[2].toUpperCase()]||m[2]}`:r;
}

function getArrivalDate(dateRaw,depT,arrT){
  if(!dateRaw) return null;
  let hasNextDay=String(arrT).includes("+1")||String(arrT).includes("#");
  let dm=dateRaw.match(new RegExp(`(\\d{1,2})\\s*(${monthsPattern})`,'i'));
  if(!dm) return null;
  let day=parseInt(dm[1]),mi=monthIndex[dm[2].toUpperCase()];
  let needNext=hasNextDay;
  if(!needNext){
    let dH=parseInt(String(depT).replace(/\+1$/,'').replace(/^#/,'').slice(0,2)||"0");
    let dM=parseInt(String(depT).replace(/\+1$/,'').replace(/^#/,'').slice(2,4)||"0");
    let aH=parseInt(String(arrT).replace(/\+1$/,'').replace(/^#/,'').slice(0,2)||"0");
    let aM=parseInt(String(arrT).replace(/\+1$/,'').replace(/^#/,'').slice(2,4)||"0");
    if(aH*60+aM<dH*60+dM) needNext=true;
  }
  if(needNext){
    day++;
    let dim=[31,28,31,30,31,30,31,31,30,31,30,31];
    if(day>dim[mi]){day=1;mi=(mi+1)%12;}
    let nm=Object.keys(monthIndex).find(k=>monthIndex[k]===mi);
    return`${day} ${monthsMap[nm]}`;
  }
  return null;
}

/* ============================================================
   GDS PARSER — fixes KWIADJ style merged codes (with or without space)
============================================================ */
function cleanFlexible(text){
  return text.split("\n").map(x=>x.trim()).filter(x=>/^(\d+|[tT])[\s\.]+[A-Za-z0-9]{2,3}/i.test(x));
}

function splitMergedCodes(str){
  // Detect six-letter IATA blocks (3+3) anywhere in the string and split them
  return str.replace(/\b([A-Za-z]{3})([A-Za-z]{3})\b/g,'$1 $2');
}

function extractAirlineCode(line){
  // Match against known airline codes first (handles alphanumeric codes like
  // 6E, J9, G9, W6... even when stuck directly onto a 4-digit flight number)
  let up=line.toUpperCase();
  let knownCodes=Object.keys(airlines).sort((a,b)=>b.length-a.length);
  for(let code of knownCodes){
    if(up.startsWith(code)){
      let nextCh=up.charAt(code.length);
      if(!nextCh||/[0-9\s]/.test(nextCh)) return code;
    }
  }
  // Fallback for unrecognized codes — never let a digit slip into the
  // candidate code (that would eat part of the flight number instead).
  // Try a 3-letter ALL-LETTER code first (only if followed by digit/space).
  let m3=up.match(/^([A-Z]{3})(?=\d|\s|$)/);
  if(m3) return m3[1];
  // Then a 2-character alphanumeric code (covers letter+digit codes like
  // "X1", stuck or spaced), as long as it contains at least one letter.
  let m2=up.match(/^([A-Z0-9]{2})(?=\d|\s|$)/);
  if(m2&&/[A-Z]/.test(m2[1])) return m2[1];
  return "";
}

function extractFlightNumber(line,ac){
  // The flight number is ALWAYS the token immediately after the airline
  // code (3 or 4 digits) — never a time. We isolate just that first
  // whitespace-delimited token so a later 4-digit clock time can never be
  // picked up by mistake.
  let idx=0;
  if(ac){
    let up=line.toUpperCase();
    let pos=up.indexOf(ac);
    if(pos!==-1) idx=pos+ac.length;
  }
  let rest=line.slice(idx).trim();
  let firstToken=rest.split(/\s+/)[0]||"";
  let m=firstToken.match(/^(\d{1,4})/);
  return m?m[1]:"";
}

function parseFlexible(line){
  let isTransit=/^[tT][\s\.]+/i.test(line.trim());
  let orig=line;
  // Split merged IATA pairs before parsing
  let expanded=splitMergedCodes(orig);
  line=expanded.replace(/^[\s\d]+[\.\s]+/,'').replace(/^[tT][\.\s]+/i,'').trim();
  let ac=extractAirlineCode(line);
  let flightNo=extractFlightNumber(line,ac);
  let dateMatch=orig.match(new RegExp(`(\\d{1,2})\\s*(${monthsPattern})`,'i'));
  let dateRaw=dateMatch?dateMatch[0]:"";
  let from="",to="";
  // Try six-letter merged block first in original
  let sixM=orig.match(/\b([A-Za-z]{6})\b/);
  if(sixM){from=sixM[1].slice(0,3).toUpperCase();to=sixM[1].slice(3,6).toUpperCase();}
  // Fallback: use expanded string to find separated codes
  if(!from||!to){
    let allCodes=(expanded.match(/\b([A-Za-z]{3})\b/g)||[]).map(c=>c.toUpperCase());
    let skip=["DKS","DKT","DK1","DK2","DK3","HK1","HK2","HS1","HS2","THE","FOR","AND","NOT","BKD","OPE","RAT","EDO","PER","ATE","HAS","WAS","SET"];
    let filtered=allCodes.filter(c=>!Object.values(monthIndex).includes(c)&&!Object.keys(monthsMap).includes(c)&&c!==ac&&!skip.includes(c)&&(airports[c]||cities[c]));
    if(filtered.length>=2){from=filtered[0];to=filtered[1];}
    else if(filtered.length===1){from=filtered[0];}
  }
  // Time search must NEVER look inside the airline-code + flight-number
  // region, and must only match a fully isolated 4-digit block (not a
  // substring of a longer digit run like a merged flight number).
  let fnEndIdx=0;
  {
    let up=line.toUpperCase();
    let pos=ac?up.indexOf(ac):0;
    if(pos!==-1) fnEndIdx=pos+(ac?ac.length:0);
  }
  let afterCode=line.slice(fnEndIdx);
  let fnMatch=afterCode.match(/^\s*\d{1,4}/);
  let searchStart=fnEndIdx+(fnMatch?fnMatch[0].length:0);
  let timeSearchStr=line.slice(searchStart);
  let timePattern=/(?<!\d)#?(\d{4})(?!\d)(\+1)?/g;
  let allTimes=[];
  let tm;
  while((tm=timePattern.exec(timeSearchStr))!==null){
    let t=tm[1];let h=parseInt(t.slice(0,2)),m=parseInt(t.slice(2));
    if(h<=23&&m<=59) allTimes.push(tm[0].replace('#',''));
  }
  let rawDep=allTimes[0]||"",rawArr=allTimes[1]||"";
  let cleanDep=rawDep.replace(/\+1$/,''),cleanArr=rawArr.replace(/\+1$/,'').replace(/^#/,'');
  let operatedBy=operatedByData[ac+flightNo]||null;
  return{isTransit,airlineCode:ac,flightNo,airline:airlines[ac]||ac,operatedBy,fromCode:from,toCode:to,from:airports[from]||cities[from]||from,to:airports[to]||cities[to]||to,date:formatDate(dateRaw),dateRaw,arrNextDay:getArrivalDate(dateRaw,cleanDep,rawArr),dep:to12(rawDep),arr:to12(rawArr),rawDep:cleanDep,rawArr:cleanArr};
}

async function checkAirportCodes(parsedList){
  // Ask the user to confirm every airport code's name — no automatic
  // dictionary translation is shown — UNLESS this exact code was already
