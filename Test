      html+=lccData.airline?`<div class="item">${lccData.airline}</div>`:'';
    } else {
      html+=`<div class="item leg-title">🛫 ${lccData.airline||''}</div>`;
    }
    html+=lccData.goDate?`<div class="item date-item">📅 تاريخ الرحلة: ${lccData.goDate}</div>`:'';
    html+=lccData.goTime?`<div class="item">موعد الإقلاع ${lccData.goTime}</div>`:'';
    html+=cabinGo?`<div class="item">💺 درجة الحجز: ${cabinGo}</div>`:'';
    html+=lccData.weight?`<div class="item">🧳 الوزن: ${lccData.weight}</div>`:'';
    if(isRoundTrip){
      html+=`<div class="line"></div><div class="item leg-title">🛫 العودة</div>`;
      html+=lccData.airline?`<div class="item">${lccData.airline}</div>`:'';
      html+=lccData.backDate?`<div class="item date-item">📅 تاريخ الرحلة: ${lccData.backDate}</div>`:'';
      html+=lccData.backTime?`<div class="item">موعد الإقلاع ${lccData.backTime}</div>`:'';
      html+=cabinBack?`<div class="item">💺 درجة الحجز: ${cabinBack}</div>`:'';
      html+=lccData.weight?`<div class="item">🧳 الوزن: ${lccData.weight}</div>`:'';
    }
  } else if(hasFlights){
    trips.forEach((trip,idx)=>{
      let isGo=idx===0,bc=isGo?goB:backB,wt=isGo?goW:backW;
      let cabin=isGo?cabinGo:cabinBack;
      let bt=bc=="0"?"بدون حقائب شحن + 7 كجم حقيبة يد بالطائرة":`${bc} حقيبة - ${wt} كجم وزن الحقيبة الواحدة بالشحن + 7 كجم حقيبة يد بالطائرة`;
      if(trip.length===1){
        let f=trip[0];
        html+=`<div class="line"></div>`;
        if(trips.length>1){
          html+=`<div class="item leg-title">🛫 ${tT[idx]||'مسار إضافي'}</div>`;
          html+=`<div class="item">${f.airline}</div>`;
        } else {
          html+=`<div class="item leg-title">🛫 ${f.airline}</div>`;
        }
        html+=f.operatedBy?`<div class="item">✈️ بواسطة طيران ${f.operatedBy}</div>`:'';
        html+=f.date?`<div class="item date-item">📅 تاريخ الرحلة: ${f.date}</div>`:'';
        html+=`<div class="item">من مطار "${f.from}" ➔ إلى مطار "${f.to}"</div>`;
        html+=`<div class="item">موعد الإقلاع ${f.dep}</div>`;
        html+=`<div class="item">موعد الوصول ${f.arr}${f.arrNextDay?` (${f.arrNextDay})`:''}</div>`;
        html+=cabin?`<div class="item">💺 درجة الحجز: ${cabin}</div>`:'';
        html+=`<div class="item">🧳 ${bt}</div>`;
      } else {
        let tripHeaderLabel=trips.length>1?(tT[idx]||'الرحلة'):'الرحلة';
        html+=`<div class="line"></div><div class="item transit-header" style="font-weight:900;color:#f87171;font-size:14px;">🔄 مسار ${tripHeaderLabel} (ترانزيت)</div>`;
        trip.forEach((leg,i)=>{
          html+=`<div class="item leg-title">✈️ ${lT[i]||'الرحلة'} - ${leg.airline}</div>`;
          html+=leg.operatedBy?`<div class="item">✈️ بواسطة طيران ${leg.operatedBy}</div>`:'';
          html+=leg.date?`<div class="item date-item">📅 تاريخ الرحلة: ${leg.date}</div>`:'';
          html+=`<div class="item">من مطار "${leg.from}" ➔ إلى مطار "${leg.to}"</div>`;
          html+=`<div class="item">موعد الإقلاع ${leg.dep}</div>`;
          html+=`<div class="item">موعد الوصول ${leg.arr}${leg.arrNextDay?` (${leg.arrNextDay})`:''}</div>`;
          html+=i===0&&cabin?`<div class="item">💺 درجة الحجز: ${cabin}</div>`:'';
          html+=`<div class="item">🧳 ${bt}</div>`;
          if(i<trip.length-1){
            let lv=calcLayover(leg.rawArr,trip[i+1].rawDep);
            html+=`<div class="item layover">⏱ مدة التوقف (الترانزيت) في ${leg.to}: ${lv}</div>`;
