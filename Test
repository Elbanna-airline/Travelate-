/* ============================================================
   MICRO-INTERACTIONS
============================================================ */
.card {
  transition: transform 0.25s cubic-bezier(.4,0,.2,1), box-shadow 0.25s cubic-bezier(.4,0,.2,1);
}
.card:hover {
  transform: translateY(-1px);
  box-shadow: 0 20px 56px rgba(0,0,0,.45);
}

html.light-mode .card:hover {
  box-shadow: 0 12px 32px rgba(0,0,0,0.1);
}

input, select, textarea {
  transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.btn {
  transition: transform 0.1s ease, background 0.15s ease, box-shadow 0.15s ease;
}

.btn-create {
  transition: transform 0.1s ease, background 0.15s ease, box-shadow 0.2s ease;
}

.btn-create:hover {
  box-shadow: 0 6px 24px rgba(220,38,38,.35);
}

.add-btn, .add-btn.green {
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
}

.add-btn:active, .btn:active {
  transform: scale(0.97);
}

.remove-btn {
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

.gds-cam-btn {
  transition: background 0.15s ease, border-color 0.15s ease;
}

.modal-close, .modal-copy-rules, .airport-modal-save, .airport-modal-skip,
.gds-btn-convert, .gds-btn-use, .gds-btn-cancel {
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

.currency-badge {
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}


/* ============================================================
   RESPONSIVE / MOBILE
============================================================ */
@media (max-width: 640px) {
  .container { padding: 20px 14px 0; }
  .card { padding: 22px 18px; border-radius: 14px; }
