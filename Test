function parseAnyDate(str){
  if(!str||!str.trim()) return null;
  str=str.trim();let y=new Date().getFullYear();
  let m1=str.match(/^(\d{1,2})[\/\-\.](\d{1,2})(?:[\/\-\.](\d{2,4}))?$/);
