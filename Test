<script>
/* ============================================================
   CURRENCY
============================================================ */
let currentCurrencyCode="KWD", currentCurrencyName="دينار كويتي";
function setCurrency(code,name){
  currentCurrencyCode=code; currentCurrencyName=name;
  document.querySelectorAll('.currency-badge').forEach(b=>b.classList.remove('active'));
  let el=document.getElementById('cur-'+code.toLowerCase());
  if(el) el.classList.add('active');
  saveToStorage();
}
setCurrency('KWD','دينار كويتي');

/* ============================================================
   LCC (low-cost carrier) MANUAL ENTRY TOGGLE
============================================================ */
function toggleLCC(){
  let on=document.getElementById("lccToggle").checked;
  document.getElementById("textareaWrapper").style.display=on?"none":"";
  let hint=document.getElementById("gdsHint");
  if(hint) hint.style.display=on?"none":"";
  document.getElementById("lccFields").style.display=on?"":"none";
  saveToStorage();
}

/* ============================================================
   HOTEL-ONLY TOGGLE — hides all flight-related fields
============================================================ */
function toggleHotelOnly(){
  let on=document.getElementById("hotelOnlyToggle").checked;
  document.getElementById("flightSection").style.display=on?"none":"";
  saveToStorage();
}

/* ============================================================
   PRICE VALIDATION
============================================================ */
function validatePriceInput(el){
  let v=el.value;
  if(v&&isNaN(Number(v.replace(/,/g,'')))){
    document.getElementById("priceErr").textContent="⚠️ أدخل رقماً فقط";
  } else {
    document.getElementById("priceErr").textContent="";
  }
}

/* ============================================================
   LOCAL STORAGE AUTO-SAVE
============================================================ */
function saveToStorage(){
  try{
    let data={
      dest:document.getElementById("dest").value,
      input:document.getElementById("input").value,
      price:document.getElementById("price").value,
      goBags:document.getElementById("goBags").value,
      goWeight:document.getElementById("goWeight").value,
      backBags:document.getElementById("backBags").value,
      backWeight:document.getElementById("backWeight").value,
      cabinClassGo:document.getElementById("cabinClassGo").value,
      cabinClassBack:document.getElementById("cabinClassBack").value,
      currency:currentCurrencyCode,
      currencyName:currentCurrencyName,
      lccToggle:document.getElementById("lccToggle")?.checked||false,
      hotelOnlyToggle:document.getElementById("hotelOnlyToggle")?.checked||false,
      lccAirlineName:document.getElementById("lccAirlineName")?.value||"",
      lccGoDate:document.getElementById("lccGoDate")?.value||"",
      lccGoTime:document.getElementById("lccGoTime")?.value||"",
      lccBackDate:document.getElementById("lccBackDate")?.value||"",
      lccBackTime:document.getElementById("lccBackTime")?.value||"",
      lccWeight:document.getElementById("lccWeight")?.value||""
    };
    localStorage.setItem("travelate-formdata", JSON.stringify(data));
  }catch(e){}
}

function loadFromStorage(){
  try{
    let raw=localStorage.getItem("travelate-formdata");
    if(!raw) return;
    let data=JSON.parse(raw);
    if(data.dest) document.getElementById("dest").value=data.dest;
    if(data.input) document.getElementById("input").value=data.input;
    if(data.price) document.getElementById("price").value=data.price;
    if(data.goBags) document.getElementById("goBags").value=data.goBags;
    if(data.goWeight) document.getElementById("goWeight").value=data.goWeight;
    if(data.backBags) document.getElementById("backBags").value=data.backBags;
    if(data.backWeight) document.getElementById("backWeight").value=data.backWeight;
